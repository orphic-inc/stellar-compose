STELLAR_LOG_LEVEL=info
STELLAR_LOG_TIME_FMT="YYYY-MM-DD HH:mm:ss"
STELLAR_AUTH_JWT_SECRET=changeme
STELLAR_HTTP_PORT=8080
STELLAR_HTTP_CORS_ORIGIN=https://example.org
STELLAR_PSQL_URI=postgresql://stellar:changeme@db:5432/stellar
STELLAR_SITE_URL=https://example.org
# Optional SMTP — if unset, invite emails are skipped with a warning
STELLAR_SMTP_HOST=
STELLAR_SMTP_PORT=
STELLAR_SMTP_USER=
STELLAR_SMTP_PASS=
STELLAR_SMTP_FROM=
# Optional Sentry — if unset, error reporting is disabled
STELLAR_SENTRY_DSN=
# Site identity + Golden Rules ${...} token resolution (PRD-09 / ADR-0020).
# All optional — sane defaults apply. STELLAR_PUBLIC_KB_BASE is the Stellar
# Public KB root (public-facing wiki) hosting the policy/guidance articles.
STELLAR_SITE_NAME=Stellar
STELLAR_DISABLED_CHANNEL=#disabled
STELLAR_STAFFPM_PATH=/inbox/staff
STELLAR_PUBLIC_KB_BASE=https://kb.stellargra.ph
# Public page on reaching IRC: what the Golden Rules' ${irc} links to, and what
# disabled members are told at login (api 0.10.0). Defaults to
# ${STELLAR_PUBLIC_KB_BASE}/irc. It replaces STELLAR_IRC_URL, which api 0.10.0
# ignores with a boot warning — delete it from your .env.api.
# STELLAR_IRC_GUIDE_URL=
# Reverse-proxy hops in front of the api (api 0.9.2+). 1 matches this stack's
# nginx; only change it if you add or remove a proxy layer.
# STELLAR_TRUST_PROXY_HOPS=1
# Background jobs (api 0.9.4+). All optional; the values shown are the defaults.
# The two *_MODE switches ship `off`: run `dryRun` for a release and read the
# logged counts before switching to `on`.
# Dormancy sweep — warns, then disables, inactive members.
# INACTIVITY_MODE=off
# INACTIVITY_MAX_DISABLES_PER_CYCLE=50
# INACTIVITY_INTERVAL_MS=86400000
# Class-based invite handout. Also needs a rank's inviteGrantPerPeriod above 0
# (every rank defaults to 0; stellar-ui#326 adds the field to the rank form).
# INVITE_GRANT_MODE=off
# INVITE_GRANT_INTERVAL_MS=86400000
# No switch: these two run as soon as api 0.9.5 boots.
# Invite expiry — returns lapsed invites to their inviters.
# INVITE_EXPIRY_INTERVAL_MS=3600000
# Ratio policy — lifts ratio-caused download disables once the ratio recovers.
# RATIO_POLICY_INTERVAL_MS=86400000
# Automated class progression.
# RANK_PROGRESSION_INTERVAL_MS=3600000
# Set to 1 to start none of the background jobs. Leave unset on a real site.
# DISABLE_BACKGROUND_JOBS=
# Member Feed token secret (api 0.9.6+), at least 32 characters. Unset, every
# feed URL answers 404 — a feed URL is a bearer credential, so that is the safe
# default. Rotating it revokes every member's feed links.
STELLAR_FEED_SECRET=
# Binary asset store: the largest single stored asset, in bytes (default 2 MB).
# STELLAR_ASSET_MAX_BYTES=2000000
# Remote image import (api 0.9.9+): new remote image URLs one member may add per
# rolling 24 hours, and how often the import job wakes.
# STELLAR_IMAGE_IMPORT_DAILY_LIMIT=50
# IMAGE_IMPORT_INTERVAL_MS=30000
# Smallest bounty a release request will accept, in bytes (default 100 MiB).
# STELLAR_MINIMUM_BOUNTY=104857600
# korin.pink IRC integration (ADR-0013). The app runs fine WITHOUT korin —
# each path is inert / fails closed until its keys are set. Leave blank to
# run without the IRC sidecar.
# KORIN_API_URL/KORIN_PULL_KEY: stellar→korin (metrics pull + announce push).
# STELLAR_SERVICE_KEY: bearer korin→stellar (nick lookup, link, reputation).
KORIN_API_URL=
KORIN_PULL_KEY=
KORIN_POLL_INTERVAL_MS=300000
STELLAR_SERVICE_KEY=
# Optional IRCScore channel-weight map, JSON `{"#channel": weight}`. Empty
# counts channels unweighted.
# KORIN_CHANNEL_WEIGHTS=
